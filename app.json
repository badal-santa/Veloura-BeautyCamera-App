{
  "expo": {
    "name": "Veloura",
    "slug": "Veloura",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.veloura.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#18091C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.veloura.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-transparent.png",
          "imageWidth": 200,
          "backgroundColor": "#08070C",
          "dark": {
            "image": "./assets/splash-transparent.png",
            "backgroundColor": "#08070C"
          }
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take beauty photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save your edited photos to your library.",
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "style": "dark",
          "enforceContrast": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to open photos you choose for editing.",
          "microphonePermission": false
        }
      ],
      "./plugins/withHomeMode",
      "expo-video",
      "./plugins/withReleaseSigning"
    ],
    "backgroundColor": "#08070C",
    "scheme": "veloura"
  }
}
